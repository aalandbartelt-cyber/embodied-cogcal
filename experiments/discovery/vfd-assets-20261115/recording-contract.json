  "table_schemas": {
    "runs": "CREATE TABLE runs (\n\trun_id TEXT NOT NULL, \n\tmodel_id TEXT, \n\ttask TEXT, \n\tbackend TEXT, \n\tcapture_mode TEXT, \n\tstatus TEXT, \n\tstarted_at FLOAT, \n\tended_at FLOAT, \n\tn_steps INTEGER, \n\tn_episodes INTEGER, \n\tsuccess_rate FLOAT, \n\tmeta JSON, \n\tPRIMARY KEY (run_id)\n)",
    "steps": "CREATE TABLE steps (\n\tid INTEGER NOT NULL, \n\trun_id TEXT, \n\tep_idx INTEGER, \n\tstep_idx INTEGER, \n\tt FLOAT, \n\tobservation_state JSON, \n\taction JSON, \n\tlatency_ms FLOAT, \n\tactor INTEGER, \n\tvision_embed_norm FLOAT, \n\tvision_embed_std FLOAT, \n\taction_head_mean JSON, \n\taction_head_std JSON, \n\tsmd FLOAT, \n\trnd FLOAT, \n\tace FLOAT, \n\tPRIMARY KEY (id)\n)",
    "frames": "CREATE TABLE frames (\n\tid INTEGER NOT NULL, \n\trun_id TEXT, \n\tep_idx INTEGER, \n\tstep_idx INTEGER, \n\tt FLOAT, \n\tcamera TEXT, \n\tblob_path TEXT, \n\tPRIMARY KEY (id)\n)",
    "events": "CREATE TABLE events (\n\tid INTEGER NOT NULL, \n\trun_id TEXT, \n\ttype TEXT, \n\tts FLOAT, \n\tpayload JSON, \n\tPRIMARY KEY (id)\n)"
  },
